/*
 * ESP32S3 12 LED Sequencer (pulse-frequency inputs)
 * Controls 12 LEDs with pulsed inputs (Revs: 0..200 pulses/s, Prop: 0..200 pulses/s) and prints measured frequencies via Serial
 *
 * GPIO Pin Mapping (adjustable based on your hardware):
 * LED 1-12: GPIO 16,17,18,19,20,21,40,41,42,45,46,47
 * Pulse inputs (use GPIOs that support interrupts):
 *   Revs  -> REV_PIN (0..200 pulses/s) -- divide pulses by 2 to get rev Hz
 *   Prop  -> PROP_PIN (0..200 pulses/s) -- divide pulses by 2 to get prop Hz (no baseline subtraction)
 *
 * Serial output: prints raw pulse counts, computed Hz, inputValue (ratio), and active LED
 *
 * New: Learn Mode using a single physical button (LEARN_BTN_PIN).
 * - Enter Learn Mode by holding the learn button for >= 1000 ms (long press).
 * - While in Learn Mode, short presses advance steps:
 *    Press 1: flash LED 2 (index 1)
 *    Press 2: store inputValue as Gear1, flash LED 5 (index 4)
 *    Press 3: store inputValue as Gear2, flash LED 8 (index 7)
 *    Press 4: store inputValue as Gear3, flash LED 11 (index 10)
 *    Press 5: store inputValue as Gear4, flash LED 12 (index 11) and exit Learn Mode
 *
 * Gear mapping: when all four Gear values are learned and strictly increasing, the inputValue
 * is first checked against per-anchor percentage windows (configurable). If it falls within
 * a window around an anchor the corresponding anchor LED is selected. If no window matches
 * the code falls back to linear interpolation across the segments between anchors.
 */

// LED Pin Definitions
const int NUM_LEDS = 12;
const int ledPins[NUM_LEDS] = {16, 17, 18, 19, 20, 21, 40, 41, 42, 45, 46, 47};

// Pulse input pin definitions
const int REV_PIN = 4;    // Revs pulse input (attach interrupt)
const int PROP_PIN = 12;  // Prop pulse input (attach interrupt)

// Learn button (single button, repeated presses)
const int LEARN_BTN_PIN = 14; // default pin for learn button (change if needed)
const unsigned long LONG_PRESS_MS = 1000; // hold duration to enter learn mode
const unsigned long DEBOUNCE_MS = 50;

// Runtime variables
float inputValue = 0.0; // Range: 0.00 to 5.00 (ratio of revHz/propHz)
int activeLed = 0;      // Which LED is currently on (0-11)

// Gear storage
float gear1 = 0.0f;
float gear2 = 0.0f;
float gear3 = 0.0f;
float gear4 = 0.0f;

// Learn mode state
bool inLearnMode = false;
int learnStep = 0; // 0 = not started, increments on each short press while in learn mode

// Which LED should flash to indicate current learn step (-1 = none)
int learnFlashLed = -1;
unsigned long learnFlashInterval = 400; // ms
unsigned long learnFlashLast = 0;
bool learnFlashState = false;

// Per-anchor window percentages (0.0 .. 1.0).
// Each value is the fraction of the nominal segment width to use as the anchor window.
// Default 0.6 means 60% of the nominal segment centered on the anchor.
float anchorWindowPct[5] = {0.6f, 0.6f, 0.6f, 0.6f, 0.6f};

// Button state for debouncing and press detection
int lastBtnReading = LOW; // with pulldown -> LOW when not pressed
int btnState = LOW; // stable state (LOW idle)
unsigned long lastDebounceTime = 0;
unsigned long btnPressStart = 0;
bool btnWasPressed = false; // edge tracking

// Pulse counting (updated from ISRs)
volatile unsigned long revPulseCount = 0;
volatile unsigned long propPulseCount = 0;

// Snapshot values used for serial output and calculation
unsigned long rawRevs = 0;
unsigned long rawProp = 0;
float revHz = 0.0f;
float propHz = 0.0f;

// Sampling window (ms) used to compute frequency; keep in sync with loop delay
const unsigned long SAMPLE_MS = 1000; // 1 second window -> 1 Hz resolution
unsigned long lastSampleMillis = 0;

// Flash state used when propHz is zero
bool propZeroFlashState = false;

void IRAM_ATTR revISR() {
  revPulseCount++;
}

void IRAM_ATTR propISR() {
  propPulseCount++;
}

void setup() {
  // Initialize serial
  Serial.begin(115200);
  delay(500);

  // Initialize all LED pins as outputs (active low - set HIGH to turn off)
  for (int i = 0; i < NUM_LEDS; i++) {
    pinMode(ledPins[i], OUTPUT);
    digitalWrite(ledPins[i], HIGH);  // Active low: HIGH = OFF
  }

  // Configure pulse input pins as inputs. If your signals are open/float, consider INPUT_PULLUP/INPUT_PULLDOWN.
  pinMode(REV_PIN, INPUT);
  pinMode(PROP_PIN, INPUT);

  // Configure learn button as input with internal pulldown (active HIGH when pressed)
  pinMode(LEARN_BTN_PIN, INPUT_PULLDOWN);

  // Attach interrupts to count pulses on rising edge. Use IRAM_ATTR on ESP32 for ISRs.
  attachInterrupt(digitalPinToInterrupt(REV_PIN), revISR, RISING);
  attachInterrupt(digitalPinToInterrupt(PROP_PIN), propISR, RISING);

  Serial.println("ESP32S3 12 LED Sequencer Started (pulse-frequency mode)");
  Serial.println("Hold Learn Button to enter Learn Mode. Short presses advance steps in Learn Mode.");
}

// Helper: check if inputValue falls inside an anchor window computed from anchors and midpoints.
// anchors[]: array of anchor input values (length m)
// anchorsLed[]: corresponding LED index for each anchor
// anchorCount: number of anchors
// pct[]: per-anchor window fraction (0..1)
// returns LED index if matched, or -1 if none matched
int mapInputUsingAnchorWindows(float value, const float anchors[], const int anchorsLed[], int anchorCount, const float pct[]) {
  if (anchorCount < 1) return -1;

  // Build nominal boundaries as midpoints between adjacent anchors
  // boundaries[0] = min (anchors[0] or 0.0), boundaries[n] = max (anchors[n-1] or 5.0)
  float boundaries[6]; // max anchors expected = 5
  int n = anchorCount;

  // For safety determine min and max span
  float minVal = anchors[0];
  float maxVal = anchors[n-1];
  if (minVal > 0.0f) minVal = 0.0f; // ensure start at 0
  if (maxVal < 5.0f) maxVal = 5.0f; // ensure end at 5.0

  // compute midpoints
  boundaries[0] = minVal;
  for (int i = 0; i < n - 1; i++) {
    boundaries[i+1] = (anchors[i] + anchors[i+1]) / 2.0f;
  }
  boundaries[n] = maxVal;

  // For each anchor compute its nominal segment (boundaries[i] .. boundaries[i+1])
  for (int i = 0; i < n; i++) {
    float segLo = boundaries[i];
    float segHi = boundaries[i+1];
    float segCenter = anchors[i];
    // Nominal half-width
    float halfNominal = (segHi - segLo) / 2.0f;
    // Window half-width scaled by pct
    float halfWin = halfNominal * constrain(pct[i], 0.0f, 1.0f);
    float winLo = segCenter - halfWin;
    float winHi = segCenter + halfWin;
    // Clamp to nominal segment
    if (winLo < segLo) winLo = segLo;
    if (winHi > segHi) winHi = segHi;
    if (value >= winLo && value <= winHi) {
      return anchorsLed[i];
    }
  }

  return -1;
}

void loop() {
  // Poll button frequently so we can detect long press / short presses responsively
  pollLearnButton();

  unsigned long now = millis();

  // Sample pulses and compute input only once per SAMPLE_MS
  if (now - lastSampleMillis >= SAMPLE_MS) {
    lastSampleMillis = now;

    // Read pulses and compute input
    computeInputFromPulses();

    // Print debug values
    Serial.print("CountRevs: ");
    Serial.print(rawRevs);
    Serial.print("  CountProp: ");
    Serial.print(rawProp);
    Serial.print("  RevsHz: ");
    Serial.print(revHz, 2);
    Serial.print("  PropHz: ");
    Serial.print(propHz, 2);
    Serial.print("  Input: ");
    Serial.print(inputValue, 3);
    Serial.print("  LED: ");
    Serial.println(activeLed + 1); // 1..12 for human reading

    // If propHz is zero, toggle flash state each sample to create a blinking effect
    if (propHz <= 0.0f) {
      propZeroFlashState = !propZeroFlashState;
    } else {
      propZeroFlashState = false;
    }
  }

  // Update LED display continuously so learn-step flashes are smooth
  updateLeds();

  // Small delay so loop stays responsive but doesn't burn CPU
  delay(20);
}

// Read pulse counts (atomically), compute Hz for the SAMPLE_MS window, avoid divide-by-zero, and set inputValue
void computeInputFromPulses() {
  // Atomically capture and clear counts collected by ISRs
  noInterrupts();
  unsigned long revCount = revPulseCount;
  unsigned long propCount = propPulseCount;
  revPulseCount = 0;
  propPulseCount = 0;
  interrupts();

  rawRevs = revCount;
  rawProp = propCount;

  // Compute frequency in Hz based on the SAMPLE_MS sampling window
  // revCount is pulses per SAMPLE_MS; for SAMPLE_MS==1000 this is pulses per second
  revHz = ((float)revCount) * (1000.0f / (float)SAMPLE_MS);
  // Revs sensor produces 0..200 pulses/s; divide by 2 to get revolutions per second (Hz)
  revHz = revHz / 2.0f;

  // Prop sensor now treated like revs: 0..200 pulses/s; divide by 2 to get prop Hz (no baseline subtraction)
  propHz = ((float)propCount) * (1000.0f / (float)SAMPLE_MS);
  propHz = propHz / 2.0f;

  // Constrain measured frequencies to expected ranges
  if (revHz < 0.0f) revHz = 0.0f;
  if (revHz > 100.0f) revHz = 100.0f; // after dividing pulses by 2, max expected is 100 Hz
  if (propHz < 0.0f) propHz = 0.0f;
  if (propHz > 100.0f) propHz = 100.0f;

  // Avoid division by zero; if propHz is zero set inputValue to 0.0
  if (propHz <= 0.0f) {
    inputValue = 0.0f;
    // activeLed left unchanged; updateLeds will handle flashing pattern when propHz==0
  } else {
    inputValue = revHz / propHz; // Ratio

    // Constrain input to expected 0.0 - 5.0 range used by the LED mapping
    if (inputValue < 0.0f) inputValue = 0.0f;
    if (inputValue > 5.0f) inputValue = 5.0f;

    // If user has stored valid gear thresholds (strictly increasing), map inputValue to LEDs using those
    bool hasGears = (gear1 > 0.0f && gear2 > gear1 && gear3 > gear2 && gear4 > gear3);
    if (hasGears) {
      // Define anchor arrays
      const int anchorCount = 5;
      float anchors[anchorCount];
      int anchorLeds[anchorCount];
      anchors[0] = 0.0f;      anchorLeds[0] = 0;   // LED 1
      anchors[1] = gear1;    anchorLeds[1] = 4;   // LED 5
      anchors[2] = gear2;    anchorLeds[2] = 7;   // LED 8
      anchors[3] = gear3;    anchorLeds[3] = 10;  // LED 11
      anchors[4] = gear4;    anchorLeds[4] = 11;  // LED 12

      // First try mapping using percentage windows around anchors
      int idx = mapInputUsingAnchorWindows(inputValue, anchors, anchorLeds, anchorCount, anchorWindowPct);
      if (idx >= 0) {
        activeLed = idx;
      } else {
        // Fallback to linear interpolation between anchors (previous behavior)
        if (inputValue <= anchors[1]) {
          float frac = (anchors[1] > 0.0001f) ? (inputValue / anchors[1]) : 0.0f;
          int i = anchorLeds[0] + (int)round(frac * (anchorLeds[1] - anchorLeds[0]));
          activeLed = constrain(i, 0, NUM_LEDS - 1);
        } else if (inputValue <= anchors[2]) {
          float frac = (inputValue - anchors[1]) / (anchors[2] - anchors[1]);
          int i = anchorLeds[1] + (int)round(frac * (anchorLeds[2] - anchorLeds[1]));
          activeLed = constrain(i, 0, NUM_LEDS - 1);
        } else if (inputValue <= anchors[3]) {
          float frac = (inputValue - anchors[2]) / (anchors[3] - anchors[2]);
          int i = anchorLeds[2] + (int)round(frac * (anchorLeds[3] - anchorLeds[2]));
          activeLed = constrain(i, 0, NUM_LEDS - 1);
        } else if (inputValue <= anchors[4]) {
          float frac = (inputValue - anchors[3]) / (anchors[4] - anchors[3]);
          int i = anchorLeds[3] + (int)round(frac * (anchorLeds[4] - anchorLeds[3]));
          activeLed = constrain(i, 0, NUM_LEDS - 1);
        } else {
          activeLed = anchorLeds[4];
        }
      }
    } else {
      // Fallback to original full-range mapping (5.00 -> LED 1, 0.00 -> LED 12)
      activeLed = map((int)(inputValue * 100.0f), 500, 0, 0, NUM_LEDS - 1);
      if (activeLed >= NUM_LEDS) activeLed = NUM_LEDS - 1;
      if (activeLed < 0) activeLed = 0;
    }
  }
}

// Update LED display - only one LED on at a time (active low). If propHz==0, flash LEDs 2,5,8,11 and keep LED 12 off
void updateLeds() {
  allLedsOff();

  unsigned long now = millis();

  // If in Learn Mode, show the learn-step flashing LED (persistent until next step)
  if (inLearnMode) {
    if (learnFlashLed >= 0 && learnFlashLed < NUM_LEDS) {
      // toggle flash state based on interval
      if (now - learnFlashLast >= learnFlashInterval) {
        learnFlashLast = now;
        learnFlashState = !learnFlashState;
      }
      if (learnFlashState) {
        digitalWrite(ledPins[learnFlashLed], LOW); // ON (active low)
      } else {
        digitalWrite(ledPins[learnFlashLed], HIGH); // OFF
      }
    } else {
      // no step selected yet; blink LED1 as a general indicator
      static unsigned long lastBlink = 0;
      if (now - lastBlink < 500) {
        digitalWrite(ledPins[0], LOW); // ON
      } else if (now - lastBlink < 1000) {
        digitalWrite(ledPins[0], HIGH); // OFF
      } else {
        lastBlink = now;
      }
    }
    return;
  }

  if (propHz <= 0.0f) {
    // Flash LEDs 2,5,8,11 (indexes 1,4,7,10) when propHz is zero
    if (propZeroFlashState) {
      digitalWrite(ledPins[1], LOW);
      digitalWrite(ledPins[4], LOW);
      digitalWrite(ledPins[7], LOW);
      digitalWrite(ledPins[10], LOW);
    }
    // Ensure LED 12 (index 11) stays off - already off from allLedsOff()
    return;
  }

  // Light up only the active LED (active low: set LOW to turn ON)
  digitalWrite(ledPins[activeLed], LOW);
}

// Utility functions
void allLedsOff() {
  for (int i = 0; i < NUM_LEDS; i++) {
    digitalWrite(ledPins[i], HIGH);  // Active low: HIGH = OFF
  }
}

void allLedsOn() {
  for (int i = 0; i < NUM_LEDS; i++) {
    digitalWrite(ledPins[i], LOW);  // Active low: LOW = ON
  }
}

// Poll the single learn button, detect long press to enter Learn Mode and short presses to advance steps
void pollLearnButton() {
  int reading = digitalRead(LEARN_BTN_PIN);

  if (reading != lastBtnReading) {
    lastDebounceTime = millis();
  }

  if ((millis() - lastDebounceTime) > DEBOUNCE_MS) {
    // If the button state has changed
    if (reading != btnState) {
      btnState = reading;
      if (btnState == HIGH) {
        // Button pressed (pulled up to 3.3V with external/internal pulldown)
        btnPressStart = millis();
        btnWasPressed = true;
      } else {
        // Button released
        if (btnWasPressed) {
          unsigned long pressLen = millis() - btnPressStart;
          btnWasPressed = false;

          if (!inLearnMode && pressLen >= LONG_PRESS_MS) {
            // Long press: enter learn mode
            inLearnMode = true;
            learnStep = 0;
            learnFlashLed = -1; // no step selected yet
            Serial.println("Entered Learn Mode. Short press to advance steps.");
            // visual indicator handled in updateLeds()
          } else if (inLearnMode && pressLen < LONG_PRESS_MS) {
            // Short press while in learn mode: advance a step
            learnStep++;
            handleLearnStep(learnStep);
          }
        }
      }
    }
  }

  lastBtnReading = reading;
}

// Handle actions for each learn step
void handleLearnStep(int step) {
  switch (step) {
    case 1:
      Serial.println("Learn Step 1: Flash LED 2");
      learnFlashLed = 1; // LED 2 (index 1) will now flash until next step
      break;
    case 2:
      gear1 = inputValue;
      Serial.print("Learn Step 2: Stored Gear1 = "); Serial.println(gear1, 3);
      learnFlashLed = 4; // LED 5 (index 4)
      break;
    case 3:
      gear2 = inputValue;
      Serial.print("Learn Step 3: Stored Gear2 = "); Serial.println(gear2, 3);
      learnFlashLed = 7; // LED 8 (index 7)
      break;
    case 4:
      gear3 = inputValue;
      Serial.print("Learn Step 4: Stored Gear3 = "); Serial.println(gear3, 3);
      learnFlashLed = 10; // LED 11 (index 10)
      break;
    case 5:
      gear4 = inputValue;
      Serial.print("Learn Step 5: Stored Gear4 = "); Serial.println(gear4, 3);
      // Option: set final flash briefly then exit; we'll stop flashing when exiting
      learnFlashLed = -1;
      inLearnMode = false;
      Serial.println("Exiting Learn Mode.");
      break;
    default:
      // If steps continue beyond 5, wrap or exit; we'll exit to be safe
      Serial.println("Learn Mode: maximum steps reached, exiting.");
      learnFlashLed = -1;
      inLearnMode = false;
      break;
  }
}

// Flash a specific LED index 'times' times with duration ms each (non-blocking friendly but does small delays)
void flashLedIndex(int ledIndex, int times, unsigned long msDelay) {
  if (ledIndex < 0 || ledIndex >= NUM_LEDS) return;
  for (int i = 0; i < times; i++) {
    digitalWrite(ledPins[ledIndex], LOW);
    delay(msDelay);
    digitalWrite(ledPins[ledIndex], HIGH);
    delay(msDelay);
  }
}
